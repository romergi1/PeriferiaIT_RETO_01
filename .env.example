# Proveedor que aparece seleccionado en el chat: gemini, groq o anthropic. Solo se ofrecen los que tienen clave.
LLM_PROVIDER=gemini

# Clave de Google Gemini (gratis en https://aistudio.google.com). Nunca se sube al repositorio.
GEMINI_API_KEY=

# Clave de Groq (gratis en https://console.groq.com). Nunca se sube al repositorio.
GROQ_API_KEY=

# Clave de Anthropic (de pago). Nunca se sube al repositorio.
ANTHROPIC_API_KEY=

# Modelo de cada proveedor (opcionales)
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_MODEL=claude-haiku-4-5

# Topes de costo (opcionales)
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000

# Puerto del servidor (opcional, por defecto 7477)
PORT=7477
